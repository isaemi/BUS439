# Copy to .env (git-ignored). It is loaded automatically.

# LTIC AI Gateway: paste the key from Robin. The gateway URL is the default.
LTIC_API_KEY=paste-key-here
SHW_CHAT_MODEL=qwen3.8-27b
# Check the other model names with: python -m shw_analytics.llm --models
# SHW_FAST_MODEL=
# SHW_EMBED_MODEL=

# Local testing with Ollama instead (no key needed). Uncomment these and
# comment out the block above.
# LTIC_BASE_URL=http://localhost:11434/v1
# LTIC_API_KEY=ollama
# SHW_CHAT_MODEL=qwen3:8b
# SHW_FAST_MODEL=qwen3:8b
# SHW_EMBED_MODEL=qwen3-embedding:0.6b

# Optional
# SHW_TOOL_MODE=auto
# SHW_MAX_TOKENS=4000
# SHW_KEEP_CHANNELS=anonymous

# Qualtrics API (optional): lets the app pull exports directly.
# QUALTRICS_API_TOKEN=
# QUALTRICS_BASE_URL=https://ubc.ca1.qualtrics.com
# QUALTRICS_SURVEY_ID=SV_

# SFTP (optional): where Qualtrics' scheduled exports land, if not on this machine.
# SFTP_HOST=
# SFTP_PORT=22
# SFTP_USER=
# SFTP_PASSWORD=
# SFTP_KEY_FILE=
# SFTP_DIR=/path/to/drop/folder
# SFTP_PREFIX=shw_survey

# Secret used to anonymise CHR student and provider IDs consistently. Optional: if
# unset, one is created in data/.id_salt. Keep it private and never change it once
# real data is loaded, or the same student will get a new ID.
# SHW_ID_SALT=
